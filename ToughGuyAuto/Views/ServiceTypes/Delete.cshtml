@model ToughGuyAuto.Models.ServiceType

@{
    ViewData["Title"] = "Delete Service Type";
}

<h1>Delete Service Type</h1>

<h3>
    Are you sure you want to delete this service type?
</h3>

<div>
    <strong>Name:</strong>
    @Model.Name
</div>

<div>
    <strong>Description:</strong>
    @Model.Description
</div>

<br />

<form asp-action="Delete" method="post">

    <input type="hidden"
           name="id"
           value="@Model.ServiceTypeId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
