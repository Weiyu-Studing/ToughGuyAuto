@model ToughGuyAuto.ViewModels.VehicleEditViewModel

@{
    ViewData["Title"] = "Edit Vehicle";
}

<h1>Edit Vehicle</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit"
              asp-route-id="@Model.VehicleId"
              method="post">

            <input asp-for="VehicleId"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label asp-for="Make"
                       class="form-label">
                </label>

                <input asp-for="Make"
                       class="form-control" />

                <span asp-validation-for="Make"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Model"
                       class="form-label">
                </label>

                <input asp-for="Model"
                       class="form-control" />

                <span asp-validation-for="Model"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Year"
                       class="form-label">
                </label>

                <input asp-for="Year"
                       class="form-control"
                       type="number" />

                <span asp-validation-for="Year"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="LicensePlate"
                       class="form-label">
                </label>

                <input asp-for="LicensePlate"
                       class="form-control" />

                <span asp-validation-for="LicensePlate"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="VIN"
                       class="form-label">
                </label>

                <input asp-for="VIN"
                       class="form-control" />

                <span asp-validation-for="VIN"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Mileage"
                       class="form-label">
                </label>

                <input asp-for="Mileage"
                       class="form-control"
                       type="number" />

                <span asp-validation-for="Mileage"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
