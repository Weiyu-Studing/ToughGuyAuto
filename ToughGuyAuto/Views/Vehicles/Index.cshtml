@model IEnumerable<ToughGuyAuto.Models.Vehicle>

@{
    ViewData["Title"] = "My Vehicles";
}

<h1>My Vehicles</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Vehicle
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Year</th>
            <th>Make</th>
            <th>Model</th>
            <th>Mileage</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var vehicle in Model)
        {
            <tr>
                <td>@vehicle.Year</td>
                <td>@vehicle.Make</td>
                <td>@vehicle.Model</td>
                <td>@vehicle.Mileage km</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@vehicle.VehicleId"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@vehicle.VehicleId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete"
                           asp-route-id="@vehicle.VehicleId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>