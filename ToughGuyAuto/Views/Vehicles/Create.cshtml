@model ToughGuyAuto.ViewModels.VehicleCreateViewModel

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container">
    <h1>Add Vehicle</h1>

    <form asp-controller="Vehicles"
          asp-action="Create"
          method="post" >

        <div class="mb-3">
            <label asp-for="Make" class="form-label"></label>
            <input asp-for="Make" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Model" class="form-label"></label>
            <input asp-for="Model" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Year" class="form-label"></label>
            <input asp-for="Year"
                   class="form-control"
                   type="number" />
        </div>

        <div class="mb-3">
            <label asp-for="LicensePlate" class="form-label"></label>
            <input asp-for="LicensePlate" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="VIN" class="form-label"></label>
            <input asp-for="VIN" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Mileage" class="form-label"></label>
            <input asp-for="Mileage"
                   class="form-control"
                   type="number" />
        </div>

        <button type="submit" class="btn btn-primary">
            Create
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>