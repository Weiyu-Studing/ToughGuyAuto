@model ToughGuyAuto.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h1>Delete Vehicle</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this vehicle?
    All maintenance records belonging to this vehicle
    will also be deleted.
</div>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Make
    </dt>
    <dd class="col-sm-10">
        @Model.Make
    </dd>

    <dt class="col-sm-2">
        Model
    </dt>
    <dd class="col-sm-10">
        @Model.Model
    </dd>

    <dt class="col-sm-2">
        Year
    </dt>
    <dd class="col-sm-10">
        @Model.Year
    </dd>

    <dt class="col-sm-2">
        License Plate
    </dt>
    <dd class="col-sm-10">
        @Model.LicensePlate
    </dd>

    <dt class="col-sm-2">
        VIN
    </dt>
    <dd class="col-sm-10">
        @Model.VIN
    </dd>

</dl>

<form asp-action="Delete"
      asp-route-id="@Model.VehicleId"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>