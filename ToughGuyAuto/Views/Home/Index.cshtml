@{
    ViewData["Title"] = "Home";
}

<div class="text-center home-content">
    <h1>Tough Guy Auto</h1>

    <p>
        We have the skill to turn scrap copper into an aircraft carrier.
    </p>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-controller="Vehicles"
           asp-action="Index"
           class="btn btn-primary">
            Vehicles
        </a>

        <a asp-controller="MaintenanceRecords"
           asp-action="Index"
           class="btn btn-primary">
            Maintenance Records
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="ServiceTypes"
               asp-action="Index"
               class="btn btn-primary">
                Service Types
            </a>
        }
    }
    else
    {
        <a asp-area="Identity"
           asp-page="/Account/Login"
           class="btn btn-primary">
            Login
        </a>
    }
</div>