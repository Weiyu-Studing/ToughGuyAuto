@model ToughGuyAuto.Models.MaintenanceRecord

@{
    ViewData["Title"] = "Delete Maintenance Record";
}

<h1>Delete Maintenance Record</h1>

<h3>Are you sure you want to delete this record?</h3>

<div>
    <strong>Vehicle:</strong>
    @Model.Vehicle.Make @Model.Vehicle.Model
</div>

<div>
    <strong>Date:</strong>
    @Model.ServiceDate.ToShortDateString()
</div>

<div>
    <strong>Mileage:</strong>
    @Model.Mileage
</div>

<div>
    <strong>Cost:</strong>
    $@Model.Cost
</div>

<div>
    <strong>Description:</strong>
    @Model.Description
</div>

<br />

<form asp-action="Delete" method="post">

    <input type="hidden"
           name="id"
           value="@Model.MaintenanceRecordId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>