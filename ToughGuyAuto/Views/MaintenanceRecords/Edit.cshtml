@model ToughGuyAuto.ViewModels.MaintenanceRecordEditViewModel

@{
    ViewData["Title"] = "Edit Maintenance Record";
}

<h1>Edit Maintenance Record</h1>

<form asp-action="Edit" method="post">

    <input type="hidden"
           asp-for="MaintenanceRecordId" />

    <div asp-validation-summary="All"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="VehicleId"
               class="form-label">
            Vehicle
        </label>

        <select asp-for="VehicleId"
                class="form-control">

            @foreach (var vehicle in ViewBag.Vehicles)
            {
                <option value="@vehicle.VehicleId">
                    @vehicle.Make @vehicle.Model
                    (@vehicle.LicensePlate)
                </option>
            }

        </select>
    </div>

    <div class="mb-3">
        <label asp-for="ServiceDate"
               class="form-label">
            Service Date
        </label>

        <input asp-for="ServiceDate"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Mileage"
               class="form-label">
            Mileage
        </label>

        <input asp-for="Mileage"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Cost"
               class="form-label">
            Cost
        </label>

        <input asp-for="Cost"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description"
               class="form-label">
            Description
        </label>

        <input asp-for="Description"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Notes"
               class="form-label">
            Notes
        </label>

        <textarea asp-for="Notes"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">

        <label class="form-label">
            Service Types
        </label>

        @foreach (var service in ViewBag.ServiceTypes)
        {
            <div>
                <input type="checkbox"
                       name="SelectedServiceTypeIds"
                       value="@service.ServiceTypeId"
                @(Model.SelectedServiceTypeIds.Contains(service.ServiceTypeId)
                                  ? "checked"
                                  : "") />

                <span class="service-name">
                    @service.Name
                </span>
            </div>
        }

    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}